# Copy to backend/.env for local development. Never commit real secrets.
APP_ENV=development
LOG_JSON=false
LOG_LEVEL=INFO

# Local development: docker compose (repo root) exposes these on localhost
DATABASE_URL=postgresql+asyncpg://travelbuddy:travelbuddy@localhost:5432/travelbuddy
REDIS_URL=redis://localhost:6379/0
# Realtime fanout (ADR-0023): auto = Redis when REDIS_URL is set outside development/test.
# REALTIME_BUS=auto
# Push (BL-3.06): auto = in-memory recorder in development/test, Expo push service elsewhere.
# PUSH_PROVIDER=auto
# EXPO_ACCESS_TOKEN=

# Supabase (ADR-0018). Copy the "Session pooler" connection string from the Supabase dashboard
# (Connect → Session pooler), change the scheme to postgresql+asyncpg and add ?ssl=require.
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F).
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?ssl=require
# Transaction pooler (port 6543) instead: also set DATABASE_TRANSACTION_POOLER=true
DATABASE_TRANSACTION_POOLER=false
# Free/Nano plan allows 60 connections in total: keep per-process pools small
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# >= 32 random characters outside development/test (boot fails otherwise)
CURSOR_SIGNING_KEY=dev-only-cursor-signing-key-change-me

# JSON object of feature flags (unknown names fail at boot), e.g. {"traveler_discovery": true}
FEATURE_FLAGS={}

# Development-only adapters; refused when APP_ENV is staging or production.
# The dev IdP lets local apps sign in (POST /v1/dev/idp/token, then /v1/auth/login|register).
DEV_IDP_ENABLED=true
DEV_BILLING_ENABLED=false

# Platform sessions (architecture section 8). Required outside development/test:
#   PLATFORM_JWT_PRIVATE_KEY  Ed25519 private key, PKCS#8 PEM
#                             (openssl genpkey -algorithm ed25519)
#   REFRESH_TOKEN_DERIVATION_KEY  >= 32 random characters
# In development/test, clearly-labelled development defaults are used when unset.
# PLATFORM_JWT_PRIVATE_KEY=
# REFRESH_TOKEN_DERIVATION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Production identity providers (JSON list). Their ID tokens are verified against these JWKS.
# OIDC_ISSUERS=[{"issuer": "https://<tenant>/", "audiences": ["<client-id>"], "jwks_uri": "https://<tenant>/.well-known/jwks.json", "method": "oidc"}]

# Age gate and current legal document versions (registration must accept these exact versions)
MINIMUM_AGE=18
TERMS_VERSION=2026-11-01
PRIVACY_VERSION=2026-11-01

# Web cache revalidation webhook (SAFE-012, backlog BL-1.25; not consumed until Phase 1).
# The web side verifies with WEB_REVALIDATE_SECRETS="current,previous"; we sign with the current one.
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# WEB_REVALIDATE_SECRET=<same value as the first entry of the web's WEB_REVALIDATE_SECRETS>

# Integration tests (pytest) use these when set
# TEST_DATABASE_URL=postgresql+asyncpg://travelbuddy:travelbuddy@localhost:5432/travelbuddy_test
# TEST_REDIS_URL=redis://localhost:6379/15

# Durable jobs and the outbox relay (BL-1.09). A long-running host runs `python -m app.worker`.
# Serverless hosts (Vercel) have no worker: set CRON_SECRET (>= 32 chars) to enable
# GET|POST /internal/jobs/tick for a scheduler, and JOBS_INLINE_AFTER_RESPONSE=true to run a
# short tick after responses that recorded events.
# CRON_SECRET=
JOBS_INLINE_AFTER_RESPONSE=false
JOBS_INLINE_BUDGET_SECONDS=2
JOBS_TICK_BUDGET_SECONDS=8

# Web cache revalidation webhooks to the web app (SAFE-012, BL-1.25). Empty URL = disabled.
# The same secret goes into the web app's WEB_REVALIDATE_SECRETS.
WEB_REVALIDATE_URL=
# WEB_REVALIDATE_SECRET=
