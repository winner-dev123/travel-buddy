{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ],
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/internal/jobs/tick",
      "schedule": "0 3 * * *"
    }
  ]
}
