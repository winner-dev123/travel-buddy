{
  "expo": {
    "name": "Travel Buddy",
    "slug": "travel-buddy",
    "scheme": "travelbuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travelbuddy.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.travelbuddy.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_COARSE_LOCATION"],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "es", "pt-BR", "fr", "de"],
            "android": ["en", "es", "pt-BR", "fr", "de"]
          },
          "supportsRTL": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Travel Buddy uses your approximate location to show stories from the city you're in. It is never stored or shown to anyone.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Travel Buddy opens your photo library only when you choose photos to share in a story.",
          "cameraPermission": "Travel Buddy uses the camera when you take a photo to share in a story.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication"
    ],
    "locales": {
      "en": "./native-locales/en.json",
      "es": "./native-locales/es.json",
      "pt-BR": "./native-locales/pt-BR.json",
      "fr": "./native-locales/fr.json",
      "de": "./native-locales/de.json"
    }
  }
}
