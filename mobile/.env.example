# Copy to .env.local (git-ignored). EXPO_PUBLIC_* values are inlined into the
# JavaScript bundle at build time — never put secrets here.

# Base URL of the Travel Buddy REST API (no trailing slash, no /v1 suffix).
# Local backend via docker-compose: http://localhost:8000
# Android emulator reaching the host machine: http://10.0.2.2:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional, development only: comma-separated feature keys to force-enable
# (see src/config/featureFlags.ts). Ignored in production builds.
EXPO_PUBLIC_FEATURE_FLAGS=

# Sign-in (ADR-0028). `firebase`, `supabase` (being retired, ADR-0020) or, in development builds
# only, `dev` (the backend's development IdP; needs a local backend with DEV_IDP_ENABLED=true).
# Unset: `firebase` when EXPO_PUBLIC_FIREBASE_API_KEY is set, else `supabase`.
EXPO_PUBLIC_IDENTITY_PROVIDER=
# Firebase Authentication: the project's Web API key (AIza…, Firebase console → Project settings →
# General). It only identifies the project; a service-account key must NEVER go here.
EXPO_PUBLIC_FIREBASE_API_KEY=
# "Continue with Google" through Firebase (BL-6.12): the project's OAuth Web client ID
# (Google Cloud console → Credentials → "Web client (auto created by Google Service)"). Public.
# Needs a development or release build (the native module is not in Expo Go).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Supabase Auth. ONLY the publishable key (sb_publishable_…) may go here; the app
# refuses secret/service-role keys. Staging project:
EXPO_PUBLIC_SUPABASE_URL=https://dmvhbgxxxilcniadoqvb.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paywall purchases (ADR-0031). `test` buys through a development backend's test store
# (DEV_BILLING_ENABLED=true) in development builds only; anything else shows the offers without
# a buy button until the App Store / Google Play adapter ships. Release builds ignore it.
EXPO_PUBLIC_PURCHASES=
