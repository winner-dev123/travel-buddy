# Travel Buddy web — environment template. Copy to .env.local for local development.
# Rules enforced at startup (src/server/env-core.ts):
#   - TB_API_MODE=mock and TB_IDENTITY_PROVIDER=dev are ONLY allowed with APP_ENV=development|test|demo.
#   - demo (hosted sample-data deployment, e.g. Vercel) requires SESSION_SECRET (>= 32 chars).
#   - staging/production require API_BASE_URL, SESSION_SECRET (>= 32 chars), SUPABASE_* and NEXT_PUBLIC_MAP_STYLE_URL.
# On Vercel, NEXT_PUBLIC_SITE_URL may be omitted: it falls back to https://$VERCEL_PROJECT_PRODUCTION_URL.

APP_ENV=development

# mock = in-process mock adapter (clearly labelled "Mock data" in the UI); live = FastAPI platform
TB_API_MODE=mock
# API_BASE_URL=http://localhost:8000
# REALTIME_URL=ws://localhost:8001/v1/realtime

# dev = persona picker backed by the platform dev IdP; oidc = production identity provider
TB_IDENTITY_PROVIDER=dev

# 32+ random characters, e.g. `openssl rand -base64 48`. A labelled development fallback is used
# in development/test when unset.
# SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MapLibre style URL from the licensed tile provider (ADR-0014). Dev falls back to the MapLibre demo style.
# NEXT_PUBLIC_MAP_STYLE_URL=

# CDN host for platform media (next/image remote pattern)
# NEXT_PUBLIC_MEDIA_HOST=media.example.com

# App store links; the download buttons show "coming soon" when unset
# NEXT_PUBLIC_IOS_APP_URL=
# NEXT_PUBLIC_ANDROID_APP_URL=

# Supabase Auth, the identity provider (ADR-0020). Default outside development/test.
# Publishable key only (sb_publishable_... or the legacy anon JWT); secret/service-role keys are refused.
# Add <site>/api/auth/callback to the Supabase redirect allow-list.
# TB_IDENTITY_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Generic OIDC (not implemented; kept for a future non-Supabase IdP)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://www.example.com/api/auth/callback

# HMAC secrets for the platform's cache-revalidation webhook (POST /api/revalidate, SAFE-012).
# "current,previous" during rotation; each at least 32 characters. Unset = endpoint disabled (404).
# WEB_REVALIDATE_SECRETS=

# Optional: serve /admin only on these hosts (comma-separated)
# ADMIN_ALLOWED_HOSTS=admin.example.com
