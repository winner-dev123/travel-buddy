    "@travelbuddy/ui": "*",
    "@travelbuddy/validation": "*",
    "jose": "6.2.16",
    "lucide-react": "1.70.0",
    "maplibre-gl": "6.17.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
