{
  "name": "@travelbuddy/web",
  "version": "0.1.0",
  "private": true,
  "description": "Travel Buddy web: public site, traveler app and admin (Next.js App Router).",
  "type": "module",
  "scripts": {
    "vendor:copy": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "next build",
    "start": "next start",
