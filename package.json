{
  "name": "travelbuddy",
  "private": true,
  "type": "module",
  "description": "Travel Buddy — global AI travel guide and social community platform (web monorepo).",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @travelbuddy/web",
    "build": "npm run build -w @travelbuddy/web",
    "start": "npm run start -w @travelbuddy/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @travelbuddy/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "gen:types": "openapi-typescript contracts/openapi/openapi.yaml --default-non-nullable false -o packages/domain-types/src/generated.ts",
    "gen:types:check": "npm run gen:types && git diff --exit-code -- packages/domain-types/src/generated.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
