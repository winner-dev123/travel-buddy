{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.travelbuddy.example/realtime/client.message.delete.schema.json",
  "title": "client → server: message.delete",
  "description": "Delete own message, or remove another member's message with the group permission `messages.remove` (reason_code required then).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "type": {
      "const": "message.delete"
    },
    "data": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "$ref": "envelope.schema.json#/$defs/Uuid"
        },
        "message_id": {
          "$ref": "envelope.schema.json#/$defs/Uuid"
        },
        "reason_code": {
          "type": "string",
          "maxLength": 40
        }
      },
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "message_id"
      ]
    }
  },
  "not": {
    "required": [
      "reply_to"
    ]
  }
}
