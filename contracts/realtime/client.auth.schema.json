{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.travelbuddy.example/realtime/client.auth.schema.json",
  "title": "client → server: auth",
  "description": "Must be the first frame, within 5 s of the WebSocket opening. Credentials are never sent in the URL. It is also sent again on an open connection to re-authenticate after `auth.expiring`. `data` carries EXACTLY ONE of `access_token` (mobile) or `ticket` (web, single use, from POST /v1/realtime/tickets).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "type": {
      "const": "auth"
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "access_token": {
              "type": "string",
              "minLength": 20,
              "maxLength": 4096
            },
            "client": {
              "$ref": "envelope.schema.json#/$defs/ClientPlatform"
            },
            "app_version": {
              "type": "string",
              "maxLength": 32
            }
          },
          "additionalProperties": false,
          "required": [
            "access_token"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ticket": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "client": {
              "const": "web"
            },
            "app_version": {
              "type": "string",
              "maxLength": 32
            }
          },
          "additionalProperties": false,
          "required": [
            "ticket"
          ]
        }
      ]
    }
  },
  "not": {
    "required": [
      "reply_to"
    ]
  }
}
