{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.travelbuddy.example/realtime/envelope.schema.json",
  "title": "Realtime frame envelope (v1)",
  "description": "Every frame in both directions is a single JSON text message with this envelope. Binary frames are rejected.",
  "type": "object",
  "required": [
    "v",
    "type",
    "id",
    "ts"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1,
      "description": "Protocol version."
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z_]+)*$"
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "Frame ID (UUID) generated by the sender. Used for correlation and de-duplication."
    },
    "ts": {
      "$ref": "#/$defs/Timestamp",
      "description": "Sender clock time. Informational only; the server never trusts client timestamps for ordering."
    },
    "reply_to": {
      "$ref": "#/$defs/Uuid",
      "description": "Server frames only: the `id` of the client frame this frame answers (ack, error, rate_limited, auth.ok/auth.error)."
    },
    "data": {
      "type": "object"
    }
  },
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Per-conversation monotonic sequence number."
    },
    "ClientPlatform": {
      "enum": [
        "ios",
        "android",
        "web"
      ]
    },
    "MediaRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "processing",
            "unavailable"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "url_expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "blurhash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "status",
        "url",
        "url_expires_at"
      ]
    },
    "UserSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "handle": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "avatar": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "handle",
        "display_name",
        "avatar"
      ]
    },
    "MessagePreview": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "sender_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/MessageKind"
        },
        "snippet": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 140
        },
        "deleted": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "seq",
        "sender_id",
        "kind",
        "snippet",
        "deleted",
        "created_at"
      ]
    },
    "MessageKind": {
      "enum": [
        "text",
        "image",
        "system",
        "announcement"
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "conversation_id": {
          "$ref": "#/$defs/Uuid"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "client_message_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only on frames delivered to the sender's own devices."
        },
        "sender": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/MessageKind"
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MediaRef"
          }
        },
        "reply_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/MessagePreview"
            },
            {
              "type": "null"
            }
          ]
        },
        "thread_root_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "thread_reply_count": {
          "type": "integer",
          "minimum": 0
        },
        "mentions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          }
        },
        "reactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "emoji": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "reacted_by_me": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "emoji",
              "count",
              "reacted_by_me"
            ]
          }
        },
        "pinned": {
          "type": "boolean"
        },
        "moderation_state": {
          "enum": [
            "visible",
            "removed_by_moderator",
            "removed_by_admin"
          ]
        },
        "edited_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "deleted_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "conversation_id",
        "seq",
        "sender",
        "kind",
        "body",
        "attachments",
        "reply_to",
        "thread_root_id",
        "thread_reply_count",
        "mentions",
        "reactions",
        "pinned",
        "moderation_state",
        "edited_at",
        "deleted_at",
        "created_at"
      ],
      "description": "Mirror of the OpenAPI `Message` schema (contracts/openapi/openapi.yaml). Must stay identical; CI compares them."
    },
    "RealtimeErrorCode": {
      "enum": [
        "bad_frame",
        "unsupported_version",
        "unknown_type",
        "validation_failed",
        "unauthenticated",
        "token_expired",
        "token_invalid",
        "ticket_invalid",
        "session_revoked",
        "account_suspended",
        "origin_not_allowed",
        "auth_timeout",
        "not_found",
        "forbidden",
        "connection_required",
        "member_restricted",
        "chat_admins_only",
        "message_edit_window_expired",
        "media_not_ready",
        "media_rejected",
        "payload_too_large",
        "rate_limited",
        "conflict",
        "service_unavailable",
        "internal_error"
      ],
      "description": "Subset of the platform ErrorCode enum plus realtime-specific codes (bad_frame, unsupported_version, unknown_type, ticket_invalid, origin_not_allowed, auth_timeout)."
    }
  }
}
