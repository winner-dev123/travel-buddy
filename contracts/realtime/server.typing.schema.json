{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.travelbuddy.example/realtime/server.typing.schema.json",
  "title": "server → client: typing",
  "description": "Typing indicator of another member. Never sent between users who have blocked each other.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "type": {
      "const": "typing"
    },
    "data": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "$ref": "envelope.schema.json#/$defs/Uuid"
        },
        "user_id": {
          "$ref": "envelope.schema.json#/$defs/Uuid"
        },
        "state": {
          "enum": [
            "started",
            "stopped"
          ]
        },
        "expires_at": {
          "$ref": "envelope.schema.json#/$defs/Timestamp"
        }
      },
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "user_id",
        "state",
        "expires_at"
      ]
    }
  }
}
