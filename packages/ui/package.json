{
  "name": "@travelbuddy/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Travel Buddy design tokens and accessible web UI primitives (Radix + Tailwind CSS 4).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@travelbuddy/config": "*",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.3"
  }
}
